# Konfigurasi backup & monitoring (salin menjadi backup.env, chmod 600).
# File ini TIDAK boleh di-commit (sudah masuk .gitignore).

# Folder arsip lokal. Sisakan ruang minimal 2x ukuran database + dokumen.
BACKUP_DIR=/var/backups/privis-track

# Retensi lokal (hari) dan remote (hari).
BACKUP_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30

# Remote rclone tujuan, contoh:
#   r2:privis-track-backup
#   b2:privis-track-backup
#   gdrive:privis-track-backup
#   gdrive-crypt:   (jika memakai crypt di atas Drive)
# Kosongkan untuk backup lokal saja.
BACKUP_REMOTE=

# Google Drive: agar retensi benar-benar menghapus (bukan masuk trash).
# Biarkan komentar jika memakai R2/B2/S3.
# RCLONE_DRIVE_USE_TRASH=false

# Healthchecks.io: URL ping sukses (script menambahkan /fail saat gagal).
BACKUP_PING_URL=

# Webhook notifikasi (payload {text, content}; cocok untuk Slack/Discord).
ALERT_WEBHOOK_URL=

# Monitoring
PUBLIC_HEALTH_URL=https://privis.briczz.my.id/health
BACKUP_MAX_AGE_HOURS=26
DISK_USAGE_MAX=85
MONITOR_PING_URL=
