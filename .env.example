# ============================================================
# PriVis Track API — contoh environment
# Salin ke `.env` lalu ganti semua nilai rahasia.
#   cp .env.example .env
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
MAX_UPLOAD_MB=20
CORS_ORIGINS=
APP_BASE_URL=https://privis.briczz.my.id
TRUST_PROXY=1
# Dokumentasi Swagger di /docs. Set false untuk menonaktifkan.
SWAGGER_ENABLED=true

# --- PostgreSQL ---
POSTGRES_DB=privis_track
POSTGRES_USER=privis
POSTGRES_PASSWORD=ubah-password-postgres

# Dipakai saat menjalankan API dari host (npm run start:dev).
# Port host 5433 untuk menghindari bentrok dengan PostgreSQL lokal.
# Di Docker Compose nilai ini di-override menjadi host `postgres`.
DATABASE_URL=postgresql://privis:ubah-password-postgres@localhost:5433/privis_track?schema=public

# --- MinIO / S3 ---
# Image hardened Chainguard (distroless, non-root UID 65532), dipin via digest.
# Override jika memakai registry/mirror MinIO lain.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:cee9a8e35885e93f14b3cb32960e5017aff74e2adfb52ba87c65003b0163886b
MINIO_ROOT_USER=privis_admin
MINIO_ROOT_PASSWORD=ubah-password-minio
MINIO_BUCKET=privis-documents
MINIO_REGION=us-east-1

# Klien MinIO untuk init satu-jalan (membuat akun layanan). Distroless, tanpa shell.
MINIO_CLIENT_IMAGE=cgr.dev/chainguard/minio-client:latest

# Akun layanan yang dipakai API (bukan root). Dibuat otomatis oleh container init.
MINIO_API_USER=privis_api
MINIO_API_PASSWORD=ubah-password-minio-api

# Dipakai API dari host; di Docker Compose di-override menjadi `minio`.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Jika menjalankan API dari host (npm run start:dev), samakan dengan akun layanan:
# MINIO_ACCESS_KEY=privis_api
# MINIO_SECRET_KEY=<sama dengan MINIO_API_PASSWORD>

# --- JWT ---
# Buat dengan: openssl rand -hex 32
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-64-hex
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-64-hex
JWT_REFRESH_TTL=604800

# --- Seed (development) ---
SEED_DEFAULT_PASSWORD=Privis123!
# Set true hanya jika benar-benar ingin seed di production:
# SEED_ALLOW_PRODUCTION=false
